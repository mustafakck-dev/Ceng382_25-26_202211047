@model List<YemekAlemi.Models.Food>

@{
    ViewData["Title"] = "Catering Companies";
}

<div class="hero-section">
    <h1>Discover Professional Catering Companies Near You</h1>

    <p>
        Browse catering companies, explore meal packages,
        customize orders, and complete catering requests easily.
    </p>
</div>
@if (ViewBag.TopRatedFoods != null)
{
    <div class="top-rated-section">

        <h2>🔥 Top Rated Catering Packages</h2>

        <div class="top-rated-grid">

            @foreach (var item in ViewBag.TopRatedFoods)
            {
                <div class="top-rated-card">

                    <img src="@item.Food.ImageUrl" alt="@item.Food.Name" />

                    <h3>@item.Food.Name</h3>

                    <p>@item.Food.RestaurantName</p>

                    <div class="top-rating">
                        ⭐ @Math.Round(item.AverageRating, 1) / 5
                    </div>

                </div>
            }

        </div>

    </div>
}

<div class="location-layout">

    <div class="card location-card">

        <h2>Find Nearby Catering Companies</h2>

        <form method="get" asp-controller="Home" asp-action="Index">

            <label>Your Latitude</label>
            <input id="userLat" type="text" name="userLat" value="@ViewBag.UserLat" placeholder="Example: 39.9208" />

            <label>Your Longitude</label>
            <input id="userLng" type="text" name="userLng" value="@ViewBag.UserLng" placeholder="Example: 32.8541" />

            <label>Max Distance (km)</label>
            <input type="text" name="maxDistanceKm" value="@ViewBag.MaxDistanceKm" placeholder="Example: 5" />

            <button type="button" onclick="getMyLocation()">
                Use My Location
            </button>

            <button type="submit">
                Filter Nearby Catering Companies
            </button>

        </form>

        <a href="/Home/Index">Clear Filter</a>

    </div>

    <div class="card catering-info-card">

        <h2>How Catering Works</h2>

        <p>Choose a catering company, select a package, enter guest count and event details.</p>

        <ul>
            <li>Company-based package selection</li>
            <li>Guest count pricing</li>
            <li>Event date and address</li>
            <li>Receipt and agreement generation</li>
        </ul>

    </div>

</div>

<div id="map" style="height:400px;
    width:100%;
    margin-top:30px;
    margin-bottom:30px;
    border-radius:18px;">
</div>

<div class="card">

    <h2>Catering Companies</h2>

    <form method="get" asp-controller="Home" asp-action="Index" class="advanced-filter-form">

        <div class="filter-grid">

            <div>
                <label>Search Catering Company</label>

                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search by company or package name" />
            </div>

            <div>
                <label>Select Catering Company</label>

                <select name="company">

                    <option value="">
                        All Catering Companies
                    </option>

                    @if (ViewBag.Companies != null)
                    {
                        foreach (var company in ViewBag.Companies)
                        {
                            <option value="@company" selected="@(ViewBag.SelectedCompany == company)">

                                @company

                            </option>
                        }
                    }

                </select>
            </div>

            <div>
                <label>Package Type</label>

                <select name="packageType">

                    <option value="">
                        All Package Types
                    </option>

                    @if (ViewBag.PackageTypes != null)
                    {
                        foreach (var type in ViewBag.PackageTypes)
                        {
                            <option value="@type" selected="@(ViewBag.SelectedPackageType == type)">

                                @type

                            </option>
                        }
                    }

                </select>
                <div>
                    <label>District</label>

                    <select name="district">

                        <option value="">
                            All Districts
                        </option>

                        @if (ViewBag.Districts != null)
                        {
                            foreach (var district in ViewBag.Districts)
                            {
                                <option value="@district" selected="@(ViewBag.SelectedDistrict == district)">
                                    @district
                                </option>
                            }
                        }

                    </select>
                </div>
            </div>

        </div>

        <div class="filter-buttons">

            <button type="submit">
                Search & Filter
            </button>

            <a class="btn-main" href="/Home/Index">

                Clear

            </a>

        </div>

    </form>

</div>

@if (Model == null || !Model.Any())
{
    <div class="empty-box">
        <h2>No catering companies found</h2>

        <p>
            Try increasing the distance filter
            or clear the filter to see all available catering companies.
        </p>

        <a class="btn-main" href="/Home/Index">
            Clear Filter
        </a>
    </div>
}
else
{
    <div class="menu-grid">

        @foreach (var item in Model)
        {
            <div class="menu-card">

                <div class="menu-image">

                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" />
                    }
                    else
                    {
                        <span>🍕</span>
                    }

                </div>

                <div class="menu-content">

                    <div class="company-top">

                        <h2>@item.RestaurantName</h2>

                        @{
                            var ratings = ViewBag.MenuRatings as Dictionary<int, double>;

                            var avgRating = ratings != null &&
                                            ratings.ContainsKey(item.Id)
                                ? ratings[item.Id]
                                : 0;
                        }

                        <div class="company-rating">
                            ⭐ @(avgRating > 0
                                                                                                                                ? avgRating.ToString("0.0")
                                                                                                                                : "New")
                        </div>

                    </div>

                    <p class="address">
                        @(string.IsNullOrEmpty(item.Address)
                            ? "Address not specified"
                            : item.Address)
                    </p>

                    <div class="company-preview-box">

                        <p>
                            Professional catering services for corporate meetings,
                            weddings, seminars and special organizations.
                        </p>

                        <div class="company-features">

                            <span>✔ Event Catering</span>
                            <span>✔ Guest-Based Pricing</span>
                            <span>✔ Custom Packages</span>

                        </div>

                    </div>

                    

                    
                    
                    <a class="btn-main" href="/Home/RestaurantMenus?restaurantName=@item.RestaurantName">
                        View Catering Packages
                    </a>
                </div>
            </div>
        }

    </div>
}

<script>

    function getMyLocation() {

        const latInput = document.getElementById("userLat");
        const lngInput = document.getElementById("userLng");

        if (!navigator.geolocation) {

            alert("Your browser does not support location.");
            return;
        }

        latInput.value = "Getting...";
        lngInput.value = "Getting...";

        navigator.geolocation.getCurrentPosition(

            function (position) {

                latInput.value =
                    position.coords.latitude.toFixed(6);

                lngInput.value =
                    position.coords.longitude.toFixed(6);
            },

            function () {

                latInput.value = "";
                lngInput.value = "";

                alert("Could not get your location.");
            },

            {
                enableHighAccuracy: true,
                timeout: 15000,
                maximumAge: 0
            }
        );
    }

    window.initMap = function () {

        const center = {
            lat: 39.9208,
            lng: 32.8541
        };

        const map =
            new google.maps.Map(
                document.getElementById("map"),
                {
                    zoom: 12,
                    center: center
                }
            );

        @foreach (var item in Model ?? new List<YemekAlemi.Models.Food>())
            {
                if (item.Latitude != 0 && item.Longitude != 0)
                {
                    <text>

                            const marker@(item.Id) = new google.maps.Marker({
                                position: {
                                lat: @item.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture),
                            lng: @item.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)
                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                            map: map,
                            title: "@item.RestaurantName"
                                                                                                                                                                                                                                                                                                                                                                                                                                                    });

                            const info@(item.Id) = new google.maps.InfoWindow({
                                content: `
                            <div style="min-width:200px">
                                    <strong>@item.RestaurantName</strong><br />
                                    Catering Packages Available<br />
                                                                                                                                 @item.Address<br />
                                    <strong>@item.Price ₺</strong>
                            </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                        `
                                                                                                                                                                                                                                                                                                                                                                                                                                                    });

                                                                                                                                                                                                                                                                                                                                                                                                                                                    marker@(item.Id).addListener("click", function () {
                                                                                                                                                                                                                                                                                                                                                                                                                                                        info@(item.Id).open(map, marker@(item.Id));
                                                                                                                                                                                                                                                                                                                                                                                                                                                    });

                                                                                                                                                                                                                                                                                                        </text>
                                                                                                                                                        }
        }
    };

</script>

<script async defer
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyChWqNAzis2BGu7V4Uh1dNW-cjILkMPw1c&callback=initMap">
</script>