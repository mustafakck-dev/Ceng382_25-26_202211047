@model List<YemekAlemi.Models.Food>

<h2>Available Menus</h2>

@if (!Model.Any())
{
    <p>No menu items available yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Menu Name</th>
                <th>Price</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price ₺</td>
                    <td>@item.Description</td>
                </tr>
            }
        </tbody>
    </table>
}