@model List<YemekAlemi.Models.Food>

@{
    ViewData["Title"] = ViewBag.RestaurantName + " Catering Packages";
}

<div class="section-header">
    <h1>@ViewBag.RestaurantName</h1>
    <p>Available catering packages from this company.</p>
</div>

<a class="btn-secondary" href="/Home/Index">
    ← Back to Catering Companies
</a>

<br />
<br />

@if (Model == null || !Model.Any())
{
    <div class="empty-box">
        <h2>No catering packages found</h2>
        <p>This catering company does not have any packages yet.</p>
    </div>
}
else
{
    <div class="menu-grid">

        @foreach (var item in Model)
        {
            <div class="menu-card">

                <div class="menu-image">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" />
                    }
                    else
                    {
                        <span>🍽️</span>
                    }
                </div>

                <div class="menu-content">

                    <h2>@item.Name</h2>

                    <p class="restaurant">
                        Catering Company: @item.RestaurantName
                    </p>

                    <p class="address">
                        @item.Address
                    </p>

                    <p>@item.Description</p>

                    <div class="package-contents-box">
                        <strong>Package Contents:</strong>

                        @if (!string.IsNullOrWhiteSpace(item.PackageContents))
                        {
                            <p>@item.PackageContents</p>
                        }
                        else
                        {
                            <p>Package contents have not been specified yet.</p>
                        }
                    </div>

                    @{
                        var ratings = ViewBag.MenuRatings as Dictionary<int, double>;
                        var avgRating = ratings != null && ratings.ContainsKey(item.Id)
                            ? ratings[item.Id]
                            : 0;
                    }

                    <div class="rating-badge">
                        ⭐ @(avgRating > 0 ? avgRating.ToString() + " / 5" : "No rating yet")
                    </div>

                    <div class="price">
                        @item.Price ₺ / guest
                    </div>

                    <form asp-controller="Home" asp-action="AddToCart" method="post">

                        <input type="hidden" name="id" value="@item.Id" />

                        <label>Package Service Add-ons</label>

                        <div class="package-addons-box modern-addons">
                            <label>Optional Package Add-ons</label>

                            @if (item.CustomizationOptions != null && item.CustomizationOptions.Any())
                            {
                                @foreach (var option in item.CustomizationOptions)
                                {
                                    <div>
                                        <input type="checkbox" name="customizationOptionIds" value="@option.Id" />

                                        <span>@option.Name (+@option.ExtraPrice ₺ / guest)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p>No add-ons available.</p>
                            }
                        </div>

                        <button type="submit">
                            Add Package to Cart
                        </button>

                    </form>

                </div>
            </div>
        }

    </div>
}