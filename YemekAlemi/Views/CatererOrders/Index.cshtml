@model List<YemekAlemi.Models.Order>

@{
    ViewData["Title"] = "My Catering Orders";
}

<div class="section-header">

    <h1>My Catering Orders</h1>

    <p>
        View, search, update and communicate about catering orders related to your company.
    </p>

</div>

<div class="card">

    <form method="get">

        <label>Search Orders</label>

        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search order id, event or package..." />

        <br />
        <br />

        <button type="submit" class="btn-main">
            Filter Orders
        </button>

        <a class="btn-secondary" href="/CatererOrders">
            Clear
        </a>

    </form>

</div>

<br />

@if (Model == null || !Model.Any())
{
    <div class="empty-box">

        <h2>No catering orders found</h2>

    </div>
}
else
{
    <table>

        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Event Type</th>
                <th>Guest Count</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Update Status</th>
                <th>Messages</th>
                <th>Order Date</th>
                <th>Packages</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var order in Model)
            {
                <tr>

                    <td>#@order.Id</td>

                    <td>@order.UserId</td>

                    <td>@order.EventType</td>

                    <td>@order.GuestCount</td>

                    <td>@order.TotalPrice ₺</td>

                    <td>
                        <span class="status-completed">
                            @order.Status
                        </span>
                    </td>

                    <td>
                        <form asp-controller="CatererOrders" asp-action="UpdateStatus" method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="orderId" value="@order.Id" />

                            <select name="status">
                                <option value="Completed" selected="@(order.Status == "Completed")">
                                    Completed
                                </option>

                                <option value="Preparing" selected="@(order.Status == "Preparing")">
                                    Preparing
                                </option>

                                <option value="Ready" selected="@(order.Status == "Ready")">
                                    Ready
                                </option>

                                <option value="Delivered" selected="@(order.Status == "Delivered")">
                                    Delivered
                                </option>
                            </select>

                            <button type="submit">
                                Update
                            </button>

                        </form>
                    </td>

                    <td>
                        <a class="btn-main" href="/Messages/Room?orderId=@order.Id">
                            Live Call
                        </a>
                    </td>

                    <td>
                        @order.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        <ul class="customization-list">

                            @foreach (var item in order.Items)
                            {
                                <li>
                                    @item.Name
                                    -
                                    @item.Quantity package
                                    -
                                    @item.Customization
                                </li>
                            }

                        </ul>
                    </td>

                </tr>
            }

        </tbody>

    </table>
}

@if (ViewBag.TotalPages > 1)
{
    <div class="pagination">

        @if (ViewBag.CurrentPage > 1)
        {
            <a href="/CatererOrders?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search">
                Previous
            </a>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            if (i == ViewBag.CurrentPage)
            {
                <span class="active-page">@i</span>
            }
            else
            {
                <a href="/CatererOrders?page=@i&search=@ViewBag.Search">
                    @i
                </a>
            }
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a href="/CatererOrders?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search">
                Next
            </a>
        }

    </div>
}