@model List<YemekAlemi.Models.CartItem>

@{
    ViewData["Title"] = "Your Cart";
}

<div class="section-header">
    <h1>Your Cart</h1>
    <p>Review your selected meals before completing your order.</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty-box">
        <h2>Your cart is empty</h2>
        <p>Add some delicious meals from the menu.</p>
        <a class="btn-main" href="/Home/Index">Back to Menus</a>
    </div>
}
else
{
    <div class="cart-card">
        <table>
            <thead>
                <tr>
                    <th>Menu</th>
                    <th>Base Price</th>
                    <th>Customization</th>
                    <th>Customization Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Price ₺</td>
                        <td>@item.Customization</td>
                        <td>@item.CustomizationPrice ₺</td>
                        <td>@item.Quantity</td>
                        <td>@((item.Price + item.CustomizationPrice) * item.Quantity) ₺</td>
                        <td>
                            <a class="mini-link"
                                   href="/Cart/Increase?foodId=@item.FoodId&customization=@Uri.EscapeDataString(item.Customization ?? "No customization")">
                                +
                            </a>

                            <a class="mini-link"
                                   href="/Cart/Decrease?foodId=@item.FoodId&customization=@Uri.EscapeDataString(item.Customization ?? "No customization")">
                                -
                            </a>

                            <a class="danger-link"
                                   href="/Cart/Remove?foodId=@item.FoodId&customization=@Uri.EscapeDataString(item.Customization ?? "No customization")">
                                Remove
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="cart-summary">
            <h2>Total Price: @Model.Sum(x => (x.Price + x.CustomizationPrice) * x.Quantity) ₺</h2>

            <div class="cart-actions">
                <a class="btn-secondary" href="/Home/Index">Continue Shopping</a>
                <a class="btn-danger" href="/Cart/Clear">Clear Cart</a>
                <a class="btn-main" href="/Payment/Index">Proceed to Payment</a>
            </div>
        </div>
    </div>
}