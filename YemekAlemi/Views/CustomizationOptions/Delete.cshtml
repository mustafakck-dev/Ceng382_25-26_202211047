@model YemekAlemi.Models.CustomizationOption

@{
    ViewData["Title"] = "Delete Customization Option";
}

<div class="auth-card">
    <h1>Delete Customization</h1>

    <p>Are you sure you want to delete this customization option?</p>

    <h2>@Model.Name</h2>
    <p>Extra Price: @Model.ExtraPrice ₺</p>
    <p>Menu Item: @Model.Food?.Name</p>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn-danger">
            Delete Permanently
        </button>
    </form>
</div>