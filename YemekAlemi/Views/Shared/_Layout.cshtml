<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - YemekAlemi Catering Platform</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar">
        <div class="nav-left">

            <a class="brand" href="/Home/Index">
                🍽 YemekAlemi Catering
            </a>

            <a href="/Home/Index">Home</a>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a href="/Dashboard/Index">Dashboard</a>
                <a href="/Profile">My Profile</a>
                <a href="/Notifications">🔔 Notifications</a>
            }

            @if (User.IsInRole("User"))
            {
                <a href="/Ratings/MyCompletedOrders">
                    My Orders
                </a>

                <a href="/Cart/Index">
                    Cart
                </a>
            }

            @if (User.IsInRole("Caterer"))
            {
                <a href="/Foods/Create">
                    New Package
                </a>

                <a href="/Foods/Index">
                    Packages
                </a>

                <a href="/CatererOrders">
                    Incoming Orders
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a href="/AdminCompanies/Create">
                    Create Company
                </a>
                <a href="/AdminCompanies/Index">
                    Manage Companies
                </a>

                <a href="/AdminLogs/Index">
                    System Logs
                </a>
            }

        </div>

        <div class="nav-right">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span class="hello-text">
                    Hello @User.Identity.Name
                </span>

                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit" class="logout-btn">
                        Logout
                    </button>
                </form>
            }
            else
            {
                <a href="/Identity/Account/Login">Login</a>
                <a href="/Identity/Account/Register">Register</a>
            }
        </div>
    </nav>

    <main class="page-container">
        @RenderBody()
    </main>

    <footer>
        © 2026 YemekAlemi Catering Platform
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>