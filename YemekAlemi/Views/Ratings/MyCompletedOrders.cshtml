@model List<YemekAlemi.Models.Order>

<h1>My Completed Orders</h1>
<div class="card">
    <form method="get" asp-controller="Ratings" asp-action="MyCompletedOrders">
        <label>Search Orders</label>
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search order id, price or food..." />

        <button type="submit">Filter Orders</button>
        <a class="btn-main" href="/Ratings/MyCompletedOrders">Clear</a>
    </form>
</div>

@if (TempData["Message"] != null)
{
    <p style="color:red;">@TempData["Message"]</p>
}

@if (Model == null || !Model.Any())
{
    <p>You do not have any completed orders yet.</p>
}
else
{
    @foreach (var order in Model)
    {
        <div
            style="background:white; padding:20px; margin-bottom:20px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.1);">
            <h3>Order #@order.Id</h3>
            <p><strong>Total:</strong> @order.TotalPrice ₺</p>
            <p><strong>Status:</strong> @order.Status</p>
            <p><strong>Date:</strong> @order.CreatedAt</p>
            <p>
                <a href="/Documents/Receipt?orderId=@order.Id">View Receipt</a> |
                <a href="/Documents/Agreement?orderId=@order.Id">View Agreement</a>
                
            </p>

            <table>
                <thead>
                    <tr>
                        <th>Food</th>
                        <th>Quantity</th>
                        <th>Customization</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.Customization</td>
                            <td>
                                <a href="/Ratings/Create?orderId=@order.Id&foodId=@item.FoodId">Rate</a>
                                <td>
                                    <a class="btn-main" href="/Call/Room?orderId=@order.Id">
                                        Live Call
                                    </a>
                                </td>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
<div class="pagination">
    @if (ViewBag.CurrentPage > 1)
    {
        <a href="/Ratings/MyCompletedOrders?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search">Previous</a>
    }

    <span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
    {
        <a href="/Ratings/MyCompletedOrders?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search">Next</a>
    }
</div>