@{
    ViewData["Title"] = "User Dashboard";
}

<h1>User Dashboard</h1>

<div class="dashboard-grid">

    <div class="dashboard-card">
        <h2>Total Orders</h2>
        <p>@ViewBag.TotalOrders</p>
    </div>

    <div class="dashboard-card">
        <h2>Completed Orders</h2>
        <p>@ViewBag.CompletedOrders</p>
    </div>

</div>
<div class="card" style="margin-top:40px;">
    @if (ViewBag.LatestOrder != null)
    {
        var order = ViewBag.LatestOrder;

        <div class="dashboard-card">

            <h2>Latest Catering Booking</h2>

            <p>
                <strong>Event Type:</strong>
                @order.EventType
            </p>

            <p>
                <strong>Guest Count:</strong>
                @order.GuestCount
            </p>

            <p>
                <strong>Event Date:</strong>
                @order.EventDate
            </p>

            <p>
                <strong>Event Address:</strong>
                @order.EventAddress
            </p>

            <p>
                <strong>Total Price:</strong>
                @order.TotalPrice ₺
            </p>

        </div>
    }
    <h2>Recent Activity</h2>

    @if (ViewBag.RecentLogs != null)
    {
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Event</th>
                    <th>Message</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var log in ViewBag.RecentLogs)
                {
                    <tr>
                        <td>@log.CreatedAt</td>
                        <td>@log.EventType</td>
                        <td>@log.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>