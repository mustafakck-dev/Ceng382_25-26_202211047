@model YemekAlemi.Models.Food

@{
    ViewData["Title"] = "Create Catering Package";
}

<div class="section-header">
    <h1>Create Catering Package</h1>
    <p>Add a new package for your catering company.</p>
</div>

<div class="card">
    <h2>Your Catering Company</h2>

    <p><strong>Company:</strong> @ViewBag.CompanyName</p>
    <p><strong>Address:</strong> @ViewBag.CompanyAddress</p>
</div>

<br />

<form asp-action="Create" method="post">

    <label>Package Name</label>
    <input asp-for="Name" placeholder="Example: Corporate Lunch Package" />

    <label>Package Price Per Guest</label>
    <input asp-for="Price" placeholder="Example: 180" />

    <label>Package Description</label>
    <textarea asp-for="Description" placeholder="Short description of the catering package..."></textarea>

    <label>Package Contents</label>
    <textarea asp-for="PackageContents"
              placeholder="Example: Grilled chicken, rice, salad, dessert, beverages..."></textarea>

    <label>Package Image URL</label>
    <input asp-for="ImageUrl" placeholder="Example: https://images.unsplash.com/..." />

    <button type="submit">
        Save Catering Package
    </button>

</form>