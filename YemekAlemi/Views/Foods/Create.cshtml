@model YemekAlemi.Models.Food

<h2>Create Menu Item</h2>

<form asp-action="Create" method="post">
    <label>Name</label>
    <input asp-for="Name" />

    <label>Price</label>
    <input asp-for="Price" />

    <label>Description</label>
    <textarea asp-for="Description"></textarea>

    <label>Restaurant Name</label>
    <input asp-for="RestaurantName" placeholder="Example: Dominos" />

    <label>Address</label>
    <input asp-for="Address" placeholder="Example: Kızılay, Ankara" />

    <label>Latitude</label>
    <input asp-for="Latitude" placeholder="Example: 39.9208" />

    <label>Longitude</label>
    <input asp-for="Longitude" placeholder="Example: 32.8541" />

    <label>Image URL</label>
    <input asp-for="ImageUrl" placeholder="Example: https://images.unsplash.com/photo-1513104890138-7c749659a591" />

    <button type="submit">Save</button>
</form>