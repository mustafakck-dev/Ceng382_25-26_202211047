@model YemekAlemi.Models.Food

@{
    ViewData["Title"] = "Edit Catering Package";
}

<div class="auth-card">

    <h1>Edit Catering Package</h1>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <label>Package Name</label>
        <input asp-for="Name" />

        <label>Package Description</label>
        <textarea asp-for="Description"></textarea>

        <label>Package Contents</label>
        <textarea asp-for="PackageContents"
                  placeholder="Example: grilled chicken, rice, salad, dessert, beverages..."></textarea>

        <label>Price Per Guest</label>
        <input asp-for="Price" />

        <label>Package Image URL</label>
        <input asp-for="ImageUrl" />

        <button type="submit">
            Save Changes
        </button>

    </form>

</div>