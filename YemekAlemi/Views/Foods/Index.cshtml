@model List<YemekAlemi.Models.Food>

@{
    ViewData["Title"] = "Manage Catering Packages";
}

<div class="section-header">
    <h1>Manage Catering Packages</h1>

    <p>
        Create, edit, delete catering packages and manage package customization options.
    </p>
</div>

<a class="btn-main" href="/Foods/Create">
    Create New Catering Package
</a>
<br />
<br />



@if (Model == null || !Model.Any())
{
    <div class="empty-box">
        <h2>No catering packages found</h2>
    </div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Image</th>
                <th>Package Name</th>
                <th>Catering Company</th>
                <th>Package Contents</th>
                <th>Price Per Guest</th>
                <th>Customizations</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" style="width:90px;height:70px;object-fit:cover;border-radius:12px;" />
                        }
                        else
                        {
                            <span>🍽️</span>
                        }
                    </td>

                    <td>@item.Name</td>

                    <td>@item.RestaurantName</td>

                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.PackageContents))
                        {
                            <span>@item.PackageContents</span>
                        }
                        else
                        {
                            <span>No package contents specified</span>
                        }
                    </td>

                    <td>@item.Price ₺</td>

                    <td>
                        @if (item.CustomizationOptions != null &&
                                                                                                                             item.CustomizationOptions.Any())
                        {
                            <ul class="customization-list">
                                @foreach (var option in item.CustomizationOptions)
                                {
                                    <li>
                                        @option.Name (+@option.ExtraPrice ₺)

                                        <a class="delete-customization" href="/CustomizationOptions/Delete/@option.Id">
                                            Delete
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>No customizations</span>
                        }

                        <br />

                        <a class="add-customization-btn" href="/CustomizationOptions/Create?foodId=@item.Id">
                            + Add Package Customization
                        </a>
                    </td>

                    <td>
                        <a class="mini-link" href="/Foods/Edit/@item.Id">
                            Edit
                        </a>

                        <a class="danger-link" href="/Foods/Delete/@item.Id">
                            Delete
                        </a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination">

            @if (ViewBag.CurrentPage > 1)
            {
                <a href="/Foods/Index?page=@(ViewBag.CurrentPage - 1)">
                    Previous
                </a>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                if (i == ViewBag.CurrentPage)
                {
                    <span class="active-page">@i</span>
                }
                else
                {
                    <a href="/Foods/Index?page=@i">@i</a>
                }
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a href="/Foods/Index?page=@(ViewBag.CurrentPage + 1)">
                    Next
                </a>
            }

        </div>
    }

}